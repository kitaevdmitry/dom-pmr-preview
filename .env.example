# Скопируйте файл как .env только для локального запуска.
# В Timeweb Cloud эти значения задаются в разделе «Переменные».
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_DATABASE_PASSWORD
ADMIN_PASSWORD=CHANGE_TO_YOUR_PRIVATE_ADMIN_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_TO_A_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS
ADMIN_NAME=Владелец сайта
ADMIN_EMAIL=owner@example.com
SITE_URL=http://localhost:8080
